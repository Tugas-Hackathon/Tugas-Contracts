# Google Calendar sync (optional — the one-click link works without this).
# Create a project at console.cloud.google.com, enable the Calendar API,
# make an OAuth 2.0 Client ID of type "Web application", and add the
# redirect URI below to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
