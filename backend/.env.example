# Production only. With DATABASE_URL set the backend uses Postgres instead of
# SQLite; leave it empty locally. Use Supabase's POOLER connection string
# (port 6543) — the direct one exhausts connections under serverless.
DATABASE_URL=
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=materials
